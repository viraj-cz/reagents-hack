# NOTE: uv.lock is deliberately NOT ignored. It is committed so every
# collaborator and every image bake resolves the identical dependency set.

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.env
.uv/
.cache/
.proto/
.pytest_cache/
.ruff_cache/
scratch/
.eval_cache/
.eval_workspace/
results/

# Real benchmark source matrices are reproducibly downloaded, never committed
# or shipped into GOD/DEMI_GOD images. V1 retains its historical fixtures; the
# stronger v2 held-out answer is evaluator-local and only its hash is public.
benchmarks/perturbseq_norman/data/source/
benchmarks/perturbseq_norman/v2/private/expected.json

# The re:SOLUTION frontend. `dist/` is already ignored above, but the UI is
# built from source on every checkout -- there is no committed bundle, so the
# Python server serves the "not built yet" page until `npm run build` runs.
web/node_modules/
web/dist/
