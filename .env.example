# Local (caller-side) credentials. TODO: copy to .env and fill in.

# Modal auth for the *caller*. Normally supplied by `modal token new`, which
# writes ~/.modal.toml -- these env vars are only needed in CI.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Anthropic key for the DEMI_GOD agent loop. This is NOT read from the local
# environment by the sandbox; it must be pushed into Modal as a Secret named
# `demigod-anthropic` (see README "Secrets"):
#   modal secret create demigod-anthropic ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
