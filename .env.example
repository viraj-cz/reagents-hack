# Local (caller-side) credentials. TODO: copy to .env and fill in.
#
# NOTE ON SCOPE: everything here is for the CALLER (you, or GOD). A DEMI_GOD
# sandbox receives none of it. Its Anthropic key arrives as a mounted Modal
# Secret, and tool credentials belong to the broker, never to the demigod.

# --- Modal (caller-side) ------------------------------------------------
# Normally supplied by `modal token new`, which writes ~/.modal.toml. These env
# vars are only needed in CI.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Model providers ----------------------------------------------------
# Used by reagents' AnthropicLLM for the GOD loop (planner/transformer/
# integrator). NOT read by the sandbox: the DEMI_GOD agent loop reads its key
# from the Modal Secret `demigod-anthropic`, created once per workspace with
#   modal secret create demigod-anthropic ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# --- God runtime feature flags ------------------------------------------
# Deferred tool providers. Off unless set; see reagents/tools/registry.py.
REAGENTS_ENABLE_MCP=1
REAGENTS_ENABLE_CONTAINERS=1

# --- Sponsor tool credentials -------------------------------------------
# Never commit real values. These belong to the TOOLBOX_BROKER once it lands;
# they are here only while tools still resolve in-process.

# Paperclip sponsor MCP.
PAPERCLIP_API_KEY=
# Optional comma-separated exact remote tool names. Empty means discover all.
PAPERCLIP_MCP_ALLOWED_TOOLS=

# Phylo/Biomni runtime authentication. Supply the complete Authorization value,
# for example: Bearer <token>.
BIOMNI_MCP_AUTHORIZATION=
BIOMNI_MCP_ALLOWED_TOOLS=

# Optional credentials used by scientific packages and model repositories.
HF_TOKEN=
